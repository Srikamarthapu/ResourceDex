# Public project configuration. Apply supabase/migrations to this project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# A legacy SUPABASE_SERVICE_ROLE_KEY may be used instead of SUPABASE_SECRET_KEY.
GEMINI_API_KEY=

# Choose an image + structured-output model available to your Google account.
# The current implementation demo verified gemini-3.5-flash.
GEMINI_MODEL=

# Optional server-only backup, used after the current Google + NVIDIA consent.
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3

# Required for AI admission. Set conservative allowances for the selected model.
# These reserve a maximum allowance, not a calculation of the final provider bill.
AI_SCAN_MAX_COST_USD=
AI_DAILY_BUDGET_USD=
